{
  "name": "@cyann/dash-lab",
  "version": "0.1.0",
  "description": "A composable React workbench for focused applications.",
  "type": "module",
  "license": "MIT",
  "author": "cyann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YannCaron/dash-lab.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "CHANGELOG.md",
    "scripts/install-hooks.mjs",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "release-node.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/dash-lab.css"
  },
  "scripts": {
    "dev": "node scripts/serve-demo.mjs --watch",
    "start": "node scripts/serve-demo.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && npm run build:lib && npm run build:demo",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/test-browser.mjs",
    "test:firefox": "node scripts/test-modal-firefox.mjs",
    "test:package": "npm run build:lib && node scripts/test-package.mjs",
    "test:publish": "node --test scripts/publish-npm.test.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev --port 6006 --host 127.0.0.1 --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "prepack": "npm run check && npm run build:lib",
    "prepare": "node scripts/install-hooks.mjs",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "test:browser:ci": "node scripts/test-browser-ci.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.8",
    "dockview-react": "8.8.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "storybook": "10.6.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
